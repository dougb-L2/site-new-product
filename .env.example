# === REQUIRED ===
# Site identity (update for each new site)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Your Site Name

# Anthropic API key for chat widget
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key for contact form and lead capture
RESEND_API_KEY=re_...

# === ANALYTICS (set in Vercel project settings) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=your-verification-code

# === OPTIONAL ===
# IndexNow key for instant search engine notification
INDEXNOW_KEY=your-indexnow-key
