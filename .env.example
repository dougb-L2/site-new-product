# === REQUIRED ===
# Site identity (update for each new site)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Your Site Name

# Anthropic API key for chat widget
ANTHROPIC_API_KEY=sk-ant-...

# SendGrid API key for contact form and lead capture.
# SendGrid is the ONLY email provider — never Resend.
SENDGRID_API_KEY=SG....

# Optional. Overrides the default From on every transactional send.
# Verified senders only: learn2@learn2.com or assessment@learn2.com.
# SENDGRID_FROM=Learn2 <learn2@learn2.com>

# === ANALYTICS (set in Vercel project settings) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=your-verification-code

# === OPTIONAL ===
# IndexNow key for instant search engine notification
INDEXNOW_KEY=your-indexnow-key
